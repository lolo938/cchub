# Environment Configuration Template
# Copy this file to .env.development, .env.staging, .env.production
# and fill in the actual values

# App Configuration
APP_NAME=ChildcareHub
APP_VERSION=1.0.0
ENVIRONMENT=development

# Firebase Configuration
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_APP_ID=your_firebase_app_id_here
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
FIREBASE_PROJECT_ID=your_project_id_here
FIREBASE_AUTH_DOMAIN=your_auth_domain_here
FIREBASE_STORAGE_BUCKET=your_storage_bucket_here
FIREBASE_MEASUREMENT_ID=your_measurement_id_here

# Firebase iOS Configuration
FIREBASE_IOS_APP_ID=your_ios_app_id_here
FIREBASE_IOS_BUNDLE_ID=com.childcarehub.childcarehubflutter

# ZegoCloud Configuration
ZEGO_APP_ID=your_zego_app_id_here
ZEGO_APP_SIGN=your_zego_app_sign_here

# API Configuration
API_BASE_URL=https://api.childcarehub.com
API_TIMEOUT=30000

# Feature Flags
ENABLE_ANALYTICS=true
ENABLE_CRASH_REPORTING=true
ENABLE_PERFORMANCE_MONITORING=true
ENABLE_DEBUG_LOGGING=false

# Third-party Services
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here